{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Remote",
  "version": "0.1.0",
  "identifier": "im.runners.remote",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Remote",
        "width": 960,
        "height": 680,
        "minWidth": 520,
        "minHeight": 400,
        "visible": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "signingIdentity": "Developer ID Application: Runners Co., Ltd (RGWVXJ8URP)",
      "minimumSystemVersion": "14.0"
    }
  }
}
